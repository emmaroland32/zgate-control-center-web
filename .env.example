# ─── ZGATE Control Center Frontend — Environment Variables ─────────────────────────────
# Copy to .env.local for local development.
# In production, set these as environment variables on your hosting platform.

# Where the BFF reaches the backend, read at request time by src/server/bff/cc-proxy.ts. The browser
# never calls the backend directly any more: it calls same-origin /api/cc and the server attaches the
# operator's token from the httpOnly session cookie. In a container this must be the INTERNAL address
# (e.g. http://controlcenter-backend:8090).
CC_BACKEND_URL=http://localhost:8090

# The public origin this app is served on. Only used to decide whether the session cookies are marked
# Secure, so it has to say https:// wherever TLS terminates in front of it.
CC_PUBLIC_URL=http://localhost:3002

# Legacy: nothing in the client bundle reads this now, and the proxy only falls back to it when
# CC_BACKEND_URL is unset. In a container it is the wrong value (it is baked at build time with the
# address the BROWSER would use), so set CC_BACKEND_URL there.
NEXT_PUBLIC_API_URL=http://localhost:8090

# App metadata
NEXT_PUBLIC_APP_NAME=ZGATE Control Center
NEXT_PUBLIC_APP_VERSION=1.0.0

# Next.js runtime URL (required for absolute redirects in middleware)
NEXTAUTH_URL=http://localhost:3002
