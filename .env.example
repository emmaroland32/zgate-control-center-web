# ─── ZGATE Control Center Frontend — Environment Variables ─────────────────────────────
# Copy to .env.local for local development.
# In production, set these as environment variables on your hosting platform.

# Backend API URL — must match server.port in application.properties (default 8090)
NEXT_PUBLIC_API_URL=http://localhost:8090

# App metadata
NEXT_PUBLIC_APP_NAME=ZGATE Control Center
NEXT_PUBLIC_APP_VERSION=1.0.0

# Next.js runtime URL (required for absolute redirects in middleware)
NEXTAUTH_URL=http://localhost:3002
